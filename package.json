{
  "name": "qa-automation-test-task",
  "version": "1.0.0",
  "private": true,
  "description": "UI (saucedemo) and API (restful-booker) test automation with Playwright + TypeScript",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky",
    "pipeline": "bun pipeline/run.ts"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.ts": "eslint --fix --max-warnings=0"
  }
}
